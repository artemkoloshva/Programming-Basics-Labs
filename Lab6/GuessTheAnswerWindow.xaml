<Window x:Class="Lab6.GuessTheAnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab6"
        mc:Ignorable="d"
        Title="memeLab" 
        Height="600" Width="800"
        MinHeight="600" MinWidth="800"
        MaxHeight="625" MaxWidth="825"
        WindowStartupLocation="CenterScreen" 
        Background="#1A1A1D">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="195*"/>
            <RowDefinition Height="389*"/>
        </Grid.RowDefinitions>
        <TextBlock 
            x:Name="FunctionTB"
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Center"
            Margin="10"
            Padding="50"
            Background="#FF095739"
            TextWrapping="Wrap"
            FontSize="50"
            Text="function" 
            FontFamily="Comic Sans MS"
            Foreground="White"
            TextAlignment="Center"/>
        <TextBox 
            x:Name="TrysTextBox"
            HorizontalAlignment="Left" 
            Margin="460,10,0,0" 
            Grid.Row="1" 
            TextWrapping="Wrap" 
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White"
            Text="3" 
            VerticalAlignment="Top" 
            Width="330" 
            Height="59" 
            BorderBrush="#00111111"
            Background="#00542E2E"/>
        <TextBlock 
            x:Name="TrysTB"
            HorizontalAlignment="Left" 
            Height="59" 
            Margin="10,10,0,0" 
            Grid.Row="1" 
            TextWrapping="Wrap" 
            Text="Введите количество пересдач:" 
            TextAlignment="Right"
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White"
            VerticalAlignment="Top" 
            Width="445"/>
        <Button 
            x:Name="DemidovichButton"
            HorizontalAlignment="Left" 
            Margin="541,69,0,0" 
            Grid.Row="1" 
            VerticalAlignment="Top" 
            Height="282" 
            Width="222"
            BorderBrush="#FF208AAC"
            BorderThickness="3"
            Click="Demidovich_Click">
            <Button.Background>
                <ImageBrush ImageSource="/Images/demidovich.jpg"/>
            </Button.Background>
        </Button>
        <TextBlock 
            x:Name="DemidovichTB"
            HorizontalAlignment="Left" 
            Margin="410,48,0,0" 
            Grid.Row="1" 
            TextWrapping="Wrap" 
            Text="Выучить матан???"
            VerticalAlignment="Top" 
            Height="47" 
            Width="267" 
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="#FFF2F272"
            RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-42.359"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock 
            x:Name="AlfaTB"
            HorizontalAlignment="Left" 
            Height="50" 
            Width="150"
            Margin="10,74,0,0" 
            Grid.Row="1" 
            TextWrapping="Wrap" 
            Text="Альфа" 
            TextAlignment="Center"
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White"
            VerticalAlignment="Top"/>
        <TextBox
            x:Name ="AlfaTextBox"
            HorizontalAlignment="Left" 
            Margin="14,133,0,0" 
            Grid.Row="1" 
            TextWrapping="Wrap" 
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White" 
            VerticalAlignment="Top" 
            Width="142" 
            Height="50"
            Text="1"
            TextAlignment="Center"
            BorderBrush="#00111111"
            Background="#FF25252A"/>
        <TextBlock 
            x:Name="SigmaTB"
            HorizontalAlignment="Left" 
            Height="50" 
            Margin="211,78,0,0" 
            Grid.Row="1" 
            TextWrapping="Wrap" 
            Text="Сигма" 
            TextAlignment="Center"
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White"
            VerticalAlignment="Top" 
            Width="150"/>
        <TextBox
            x:Name ="SigmaTextBox"
            HorizontalAlignment="Left" 
            Margin="213,133,0,0" 
            Grid.Row="1" 
            TextWrapping="Wrap" 
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White" 
            VerticalAlignment="Top" 
            Width="148" 
            Height="50"
            Text="1"
            TextAlignment="Center"
            BorderBrush="#00111111"
            Background="#FF25252A"/>
        <Button 
            x:Name="CalculeteBatton"
            Click="CalculeteBatton_Click"
            Content="Посчитать" 
            HorizontalAlignment="Left" 
            Margin="85,210,0,0" 
            Grid.Row="1" 
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White" 
            VerticalAlignment="Top" 
            Height="85" 
            Width="201" 
            Background="#FF292727"/>
        <TextBlock 
            x:Name="DemidovichTB2"
            Visibility="Hidden"
            HorizontalAlignment="Left" 
            Margin="399,154,0,0" 
            Grid.Row="1" 
            TextWrapping="Wrap" 
            Text="Вы прекрасно усвоили курс высшей математики!!!"
            VerticalAlignment="Top" 
            Height="90" 
            Width="393" 
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="#FFF2F272"
            RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-6.768"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock 
            x:Name="TrysBarTB"
            Visibility="Hidden"
            Margin="0,10,0,0" 
            TextWrapping="Wrap" 
            Text="Попыток осталось: 0" 
            TextAlignment="Center"
            VerticalAlignment="Top"
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White" 
            Height="47"
            Width="800" 
            Grid.Row="1"
            Background="#FF2F8383"/>
        <TextBox 
            x:Name="AnswerTextBox"
            Visibility="Hidden"
            HorizontalAlignment="Center" 
            Grid.Row="1" 
            TextWrapping="Wrap"
            VerticalAlignment="Top" 
            Width="304"
            FontFamily="Comic Sans MS"
            TextAlignment="Center"
            Padding="5"
            FontSize="60"
            Foreground="White" 
            BorderBrush="#00000000"
            Background="#FF25252A" 
            Height="95" 
            Margin="0,158,0,0"/>
        <TextBlock 
            x:Name="AnswerTB"
            HorizontalAlignment="Left" 
            Visibility="Hidden"
            TextWrapping="Wrap" 
            Text="Введите предполагаемый ответ" 
            FontFamily="Comic Sans MS"
            FontSize="30"
            TextAlignment="Center"
            Foreground="White" 
            VerticalAlignment="Top" 
            Height="69" 
            Margin="109,78,0,0" 
            Width="527" 
            Grid.Row="1"/>
        <Button 
            x:Name="CheckButton"
            Click="CheckButton_Click"
            Visibility="Hidden"
            Content="П р о в е р и т ь" 
            HorizontalAlignment="Center" 
            Margin="0,253,0,0" 
            Grid.Row="1" 
            FontFamily="Comic Sans MS"
            FontSize="20"
            Foreground="White" 
            VerticalAlignment="Top" 
            Height="42"
            Width="304" 
            Background="#FF64D25A"/>
        <TextBlock 
            x:Name="WinOrLoseTB"
            Visibility="Hidden"
            FontFamily="Comic Sans MS"
            Text="Вы Угадали!!!"
            TextAlignment="Center"
            Padding="190"
            FontSize="70"
            Foreground="Yellow" 
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#BF2E2828"
            Grid.RowSpan="2"/>
        <Button 
            x:Name="BackButton"
            Content="Приду на пересдачу" 
            FontFamily="Comic Sans MS"
            FontSize="25"
            Foreground="White"
            HorizontalAlignment="Left" 
            Margin="14,320,0,0" 
            Grid.Row="1" 
            VerticalAlignment="Top" 
            Height="42" 
            Width="251"
            Click="BackButton_Click"
            Background="#FFC69A2C"/>
    </Grid>
</Window>
