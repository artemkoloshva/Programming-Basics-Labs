<Window x:Class="Lab6.TetrisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab6"
        mc:Ignorable="d"
        Title="memeLab" 
        Height="700" Width="600"
        WindowStartupLocation="CenterScreen" 
        Background="#FF28282B"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="68*"/>
            <ColumnDefinition Width="29*"/>
        </Grid.ColumnDefinitions>
        <DataGrid 
            x:Name="BoardDataGrid" 
            Grid.Column="1"
            Grid.RowSpan="6" 
            AutoGenerateColumns="False" 
            FontFamily="Comic Sans MS"
            FontSize="37"
            ColumnWidth="50"
            IsReadOnly="True"
            HorizontalScrollBarVisibility="Disabled" 
            VerticalScrollBarVisibility="Disabled"
            HeadersVisibility="None"
            Background="#FF393C3C" Margin="0,68,0,68">
            <DataGrid.Resources>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </DataGrid.Resources>
        </DataGrid>
        <TextBlock 
            x:Name="TitleTetrisTB"
            Grid.Column="0" 
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Padding="0,0,150,0"
            TextWrapping="Wrap" 
            Text="TETRIS"
            TextAlignment="Center"
            FontFamily="Comic Sans MS"
            FontSize="45"
            Foreground="White"
            Background="#FF1A1A1D"/>
        <StackPanel
            Grid.Column="0"
            Grid.Row="5"
            Grid.ColumnSpan="3"
            Background="#FF1A1A1D"/>
        <Button
            x:Name="BackButton"
            Click="BackButton_Click"
            Grid.Column="2"
            Grid.Row="5"
            Content="Н а з а д"
            Margin="15,10,15,10"
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White"
            Background="#FF272626"
            BorderBrush="#00000000"/>
        <Button
            x:Name="StartButton"
            Click="StartButton_Click"
            Grid.Column="1"
            Grid.Row="5"
            Content="С т а р т"
            Margin="0,10,0,10"
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White"
            Background="#FF70B847"
            BorderBrush="#00000000"/>
        <TextBlock 
            Grid.Column="2" 
            VerticalAlignment="Top" 
            TextWrapping="Wrap" 
            Text="Уровень"
            TextAlignment="Center"
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White" Margin="0,68,0,0" Grid.RowSpan="2" Height="42"/>
        <TextBlock 
            Grid.Column="2" 
            VerticalAlignment="Top"
            Grid.Row="1" 
            TextWrapping="Wrap" 
            Text="Счёт"
            TextAlignment="Center"
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White" Height="42" Margin="0,137,0,0" Grid.RowSpan="2"/>
        <TextBlock 
            Grid.Column="2" 
            VerticalAlignment="Top"
            Grid.Row="2" 
            TextWrapping="Wrap" 
            Text="Линии"
            TextAlignment="Center"
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White" Height="42" Margin="0,137,0,0" Grid.RowSpan="2"/>
        <TextBlock 
            Grid.Column="2" 
            VerticalAlignment="Top"
            Grid.Row="4" 
            TextWrapping="Wrap" 
            Text="Тетрисы"
            TextAlignment="Center"
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White" Height="42"/>
        <TextBlock 
            x:Name="LevelTextBlock"
            Grid.Column="2" 
            Grid.Row="1"
            VerticalAlignment="Top"
            TextWrapping="Wrap" 
            Text="0" 
            TextAlignment="Center"
            FontFamily="Comic Sans MS"
            FontSize="65"
            Foreground="LightGreen"
            Background="#FF212125" Height="90" Margin="0,47,0,0"/>
        <TextBlock
            x:Name="ScoreTextBlock"
            Grid.Column="2" 
            Grid.Row="2"
            VerticalAlignment="Top"
            TextWrapping="Wrap" 
            Text="0" 
            Padding="10"
            TextAlignment="Center"
            FontFamily="Comic Sans MS"
            FontSize="50"
            Foreground="LightGreen"
            Background="#FF212125" Height="90" Margin="0,47,0,0"/>
        <TextBlock
            x:Name="LinesTextBlock"
            Grid.Column="2" 
            Grid.Row="3"
            VerticalAlignment="Top"
            TextWrapping="Wrap" 
            Text="0" 
            TextAlignment="Center"
            FontFamily="Comic Sans MS"
            FontSize="65"
            Foreground="LightGreen"
            Background="#FF212125" Height="91" Margin="0,46,0,0" Grid.RowSpan="2"/>
        <TextBlock
            x:Name="TetrisesTextBlock"
            Grid.Column="2" 
            Grid.Row="4"
            VerticalAlignment="Top"
            TextWrapping="Wrap" 
            Text="0" 
            TextAlignment="Center"
            FontFamily="Comic Sans MS"
            FontSize="65"
            Foreground="LightGreen"
            Background="#FF212125" Height="91" Margin="0,46,0,0" Grid.RowSpan="2"/>
    </Grid>
</Window>
