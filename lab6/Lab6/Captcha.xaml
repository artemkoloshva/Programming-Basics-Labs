<Window x:Class="Lab6.Captcha"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Lab6"
        mc:Ignorable="d"
        Title="Captcha"
        WindowStartupLocation="CenterScreen"
        Height="400" Width="350"
        MinHeight="400" MinWidth="350"
        MaxHeight="450" MaxWidth="400">
    <Window.Background>
        <ImageBrush TileMode="None" 
                    ImageSource="Images\troll.jpg"/>
    </Window.Background>
    <Window.Resources>
        <sys:Double x:Key="xButtonFontSize">50</sys:Double>
        <sys:Double x:Key="xButtonOpacity">0.85</sys:Double>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="25"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="XButton1" 
                Grid.Column="1"
                Click="onClickXButton"
                Content="Х"
                FontSize="{StaticResource xButtonFontSize}"
                FontFamily="Comic Sans MS"
                Margin="5"
                Grid.Row="1" 
                Opacity="{StaticResource xButtonOpacity}" Background="#FFF35555"/>
        <Button x:Name="XButton2"
                Grid.Column="2" 
                Click="onClickXButton"
                Content="Х"
                FontSize="{StaticResource xButtonFontSize}"
                FontFamily="Comic Sans MS"
                Margin="5"
                Grid.Row="1" 
                Opacity="{StaticResource xButtonOpacity}"
                Background="#FFF35555"/>
        <Button x:Name="XButton3"
                Grid.Column="3" 
                Click="onClickXButton"
                Content="Х"
                FontSize="{StaticResource xButtonFontSize}"
                FontFamily="Comic Sans MS"
                Margin="5"
                Grid.Row="1" 
                Opacity="{StaticResource xButtonOpacity}"
                Background="#FFF35555"/>
        <Button x:Name="XButton4"
                Grid.Column="1" 
                Click="onClickXButton"
                Content="Х"
                FontSize="{StaticResource xButtonFontSize}"
                FontFamily="Comic Sans MS"
                Margin="5"
                Grid.Row="2" 
                Opacity="{StaticResource xButtonOpacity}"
                Background="#FFF35555"/>
        <Button x:Name="XButton5"
                Grid.Column="2" 
                Click="onClickXButton"
                Content="Х"
                FontSize="{StaticResource xButtonFontSize}"
                FontFamily="Comic Sans MS"
                Margin="5"
                Grid.Row="2" 
                Opacity="{StaticResource xButtonOpacity}"
                Background="#FFF35555"/>
        <Button x:Name="XButton6"
                Grid.Column="3" 
                Click="onClickXButton"
                Content="Х"
                FontSize="{StaticResource xButtonFontSize}"
                FontFamily="Comic Sans MS"
                Margin="5"
                Grid.Row="2" 
                Opacity="{StaticResource xButtonOpacity}"
                Background="#FFF35555"/>
        <Button x:Name="XButton7"
                Grid.Column="1" 
                Click="onClickXButton"
                Content="Х"
                FontSize="{StaticResource xButtonFontSize}"
                FontFamily="Comic Sans MS"
                Margin="5"
                Grid.Row="3" 
                Opacity="{StaticResource xButtonOpacity}"
                Background="#FFF35555"/>
        <Button x:Name="XButton8"
                Grid.Column="2" 
                Click="onClickXButton"
                Content="Х"
                FontSize="{StaticResource xButtonFontSize}"
                FontFamily="Comic Sans MS"
                Margin="5"
                Grid.Row="3" 
                Opacity="{StaticResource xButtonOpacity}"
                Background="#FFF35555"/>
        <Button x:Name="XButton9" 
                Grid.Column="3" 
                Click="onClickXButton"
                Content="Х"
                FontSize="{StaticResource xButtonFontSize}"
                FontFamily="Comic Sans MS"
                Margin="5"
                Grid.Row="3" 
                Opacity="{StaticResource xButtonOpacity}"
                Background="#FFF35555"/>
        <TextBlock 
                HorizontalAlignment="Center" 
                Margin="0,20,0,0" 
                Grid.Row="4" 
                TextWrapping="Wrap" 
                TextAlignment="Center"
                Text="Нажмите Х чтобы пройти капчу"
                FontFamily="Comic Sans MS"
                FontSize="15"
                VerticalAlignment="Top" 
                Width="350" 
                Height="25" 
                Grid.ColumnSpan="5"/>
        <TextBlock 
                x:Name="CycleTrysTB"
                HorizontalAlignment="Center" 
                Margin="0,45,0,0" 
                Grid.Row="4" 
                TextWrapping="Wrap" 
                TextAlignment="Center"
                Text=""
                FontFamily="Comic Sans MS"
                FontSize="15"
                VerticalAlignment="Top" 
                Width="350" 
                Height="25" 
                Grid.ColumnSpan="5"/>
    </Grid>
</Window>
