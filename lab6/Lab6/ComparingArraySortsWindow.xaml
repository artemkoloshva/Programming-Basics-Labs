<Window x:Class="Lab6.ComparingArraySortsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab6"
        mc:Ignorable="d"
        Title="memeLab" 
        Height="600" Width="800"
        MinHeight="600" MinWidth="800"
        MaxHeight="601" MaxWidth="801"
        WindowStartupLocation="CenterScreen" 
        Background="#1A1A1D">
    <Window.Resources>
        <Style TargetType="DataGridCell">
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="117*"/>
            <RowDefinition Height="284*"/>
            <RowDefinition Height="183*"/>
        </Grid.RowDefinitions>
        <DataGrid 
            x:Name="ArrayDataGrid"
            ItemsSource="{Binding Items}"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            AutoGenerateColumns="False"
            RowBackground="#FF25272A"
            Grid.ColumnSpan="2"
            ColumnWidth="*"
            Margin="15,15,15,15"
            FontFamily="Comic Sans MS"
            FontSize="55"
            Foreground="White" 
            Background="#FF25272A" 
            BorderBrush="Orange"
            BorderThickness="3"
            HeadersVisibility="None"/>
        <TextBlock 
            x:Name="BabbleSortTB"
            Grid.Row="2"
            TextWrapping="Wrap" 
            Text="00:00:00.0000000"
            TextAlignment="Center"
            Margin="15,15,7,15"
            Padding="65"
            FontFamily="Comic Sans MS"
            FontSize="25"
            Foreground="White"
            Background="#FF25272A"/>
        <TextBlock 
            x:Name="InsertSortTB"
            Grid.Row="2"
            TextWrapping="Wrap" 
            Text="00:00:00.0000000"
            TextAlignment="Center"
            Margin="7,15,15,15"
            Padding="65"
            FontFamily="Comic Sans MS"
            FontSize="25"
            Foreground="White"
            Background="#FF25272A"
            Grid.Column="1"/>
        <TextBlock 
            Grid.Row="2" 
            Margin="15,7,7,0"
            Padding="1"
            TextWrapping="Wrap" 
            Text="Сортировка Пузырьком" 
            TextAlignment="Center"
            VerticalAlignment="Top" 
            Height="40"
            FontFamily="Comic Sans MS"
            FontSize="25"
            Foreground="White"
            Background="#FF34373B"/>
        <TextBlock 
            Grid.Row="2"
            Grid.Column="1"
            Margin="7,7,15,0"
            Padding="1"
            TextWrapping="Wrap" 
            Text="Сортировка Вставками" 
            TextAlignment="Center"
            VerticalAlignment="Top" 
            Height="40"
            FontFamily="Comic Sans MS"
            FontSize="25"
            Foreground="White"
            Background="#FF34373B"/>
        <Button 
            x:Name="SortButton"
            Click="SortButton_Click"
            Content="О т с о р т и р о в а т ь"
            Padding="105,0,0,0"
            VerticalAlignment="Bottom"
            Margin="160,0,15,10"
            Grid.Row="1" 
            HorizontalContentAlignment="Left"
            Grid.ColumnSpan="2" 
            Height="45"
            FontFamily="Comic Sans MS"
            FontSize="25"
            Foreground="White"
            Background="Orange"/>
        <Button 
            x:Name="DefaultArrayButton"
            Click="DefaultArrayButton_Click"
            Grid.Column="1"
            Grid.Row="1"
            VerticalAlignment="Center"
            Margin="0,0,0,80"
            HorizontalAlignment="Left"
            Content="Задефолтить"
            FontFamily="Comic Sans MS"
            FontSize="20"
            Foreground="White" 
            Height="60"
            Width="180"
            Background="#FFA08668"/>
        <Button 
            x:Name="RandomArrayButton"
            Click="RandomArrayButton_Click"
            Grid.Column="1"
            Grid.Row="1"
            Content="Сгенерить массив"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            FontFamily="Comic Sans MS"
            FontSize="20"
            Foreground="White" 
            Height="60"
            Width="180"
            Background="#FFA08668"/>
        <TextBlock 
            HorizontalAlignment="Left"
            Margin="10,10,0,0"
            Grid.Row="1"
            TextWrapping="Wrap"
            Text="Введите длину массива"
            TextAlignment="Center"
            VerticalAlignment="Top"
            FontFamily="Comic Sans MS"
            FontSize="30"
            Foreground="White"
            Height="43" 
            Width="375"/>
        <TextBox 
            x:Name="LenghtTextBox"
            HorizontalAlignment="Center" 
            Margin="0,65,0,0" 
            Grid.Row="1" 
            TextWrapping="Wrap" 
            TextAlignment="Center"
            Padding="15"
            FontFamily="Comic Sans MS"
            FontSize="50"
            Foreground="White"
            VerticalAlignment="Top" 
            Width="280" 
            Height="112"
            Background="#FF202123"
            BorderBrush="#00000000"/>
        <Button 
            Content="П р и м е н и т ь" 
            Click="CreateArray"
            HorizontalAlignment="Center" 
            Margin="0,175,0,0" 
            Grid.Row="1" 
            VerticalAlignment="Top"
            Height="26" 
            Width="280"
            FontFamily="Comic Sans MS"
            FontSize="16"
            Foreground="White"
            BorderBrush="#00000000"
            Background="#FF34373B"/>
        <Button 
            x:Name="BackButton"
            Click="BackButton_Click"
            Content="Н а з а д" 
            HorizontalAlignment="Left"
            Margin="15,0,0,10" 
            Grid.Row="1" 
            VerticalAlignment="Bottom" 
            Width="135"
            Height="45"
            FontFamily="Comic Sans MS"
            FontSize="25"
            Foreground="White"
            Background="Orange"/>
        <TextBlock 
            x:Name="WarningTB"
            Visibility="Hidden"
            HorizontalAlignment="Stretch"
            Margin="20"
            TextWrapping="Wrap"
            FontFamily="Comic Sans MS"
            TextAlignment="Center"
            FontSize="31"
            Foreground="White"
            Text="Данные не могут быть выведены на экран, так как они превышают лимит длинны"
            VerticalAlignment="Center"
            Grid.ColumnSpan="2"
            Height="82"
            Background="#FF25272A"/>
        <Button 
            x:Name="SearchMinMaxButton"
            Click="SearchMaxAndMinArray"
            Grid.Column="1"
            Grid.Row="1"
            Content="Поиск min max"
            HorizontalAlignment="Left"
            Margin="0,0,0,80"
            VerticalAlignment="Bottom" 
            FontFamily="Comic Sans MS"
            FontSize="20"
            Foreground="White" 
            Height="60"
            Width="180"
            Background="#FFA08668"/>
        <Button 
            Content="Найти среднее" 
            Click="AverageArray_Click"
            HorizontalAlignment="Right"  
            VerticalAlignment="Top"
            Height="60"
            Width="180"
            Margin="200,0,15,0"
            FontFamily="Comic Sans MS"
            FontSize="20"
            Foreground="White"
            Background="#FF5D5041"
            Grid.Column="1"
            Grid.Row="1"/>
        <TextBlock 
            x:Name="AverageTB"
            Grid.Column="1" 
            HorizontalAlignment="Right" 
            VerticalAlignment="Top"
            Margin="0,61,15,0"
            Grid.Row="1" 
            Padding="30"
            TextWrapping="Wrap"
            TextAlignment="Center"
            Text="00.0" 
            FontFamily="Comic Sans MS"
            FontSize="45"
            Foreground="White"
            Height="130" 
            Width="178"
            Background="#FF35312F"/>
    </Grid>
</Window>
