<Window x:Class="Lab6.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Lab6"
        mc:Ignorable="d"
        Title="memeLab" 
        Height="600" Width="800"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen" 
        Background="#1A1A1D">
    <Window.Resources>
        <sys:Double x:Key="menuButtonFontSize">20</sys:Double>
        <sys:Double x:Key="menuButtonOpacity">0.9</sys:Double>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Button
            x:Name="GuessTheAnswerButton"
            Grid.Column="0"
            Grid.Row="1"
            Margin="8"
            Click="GuessTheAnswerButton_Click"
            Content="Матанализ"
            FontSize="{StaticResource menuButtonFontSize}"
            FontFamily="Comic Sans MS"
            Opacity="{StaticResource menuButtonOpacity}"
            MouseEnter="Button_MouseEnter_InputMeme" 
            Background="#C3073F" 
            BorderBrush="#FF950740"/>
        <Button
            x:Name="OutputAutorInfoButton"
            Click="AuthorButton_Click"
            Grid.Column="0"
            Grid.Row="2"
            Margin="8"
            Content="Автор memeLab"
            FontSize="{StaticResource menuButtonFontSize}"
            FontFamily="Comic Sans MS"
            Opacity="{StaticResource menuButtonOpacity}"
            MouseEnter="Button_MouseEnter_InputMeme" 
            BorderBrush="#FF950740"
            Background="#C3073F"/>
        <Button
            x:Name="ComparingArraySortsButton"
            Click="ComparingArraySortsButton_Click"
            Grid.Column="0"
            Grid.Row="3"
            Margin="8"
            Content="BogoSort отсутствует"
            FontSize="{StaticResource menuButtonFontSize}"
            FontFamily="Comic Sans MS"
            Opacity="{StaticResource menuButtonOpacity}"
            MouseEnter="Button_MouseEnter_InputMeme" 
            BorderBrush="#FF950740"
            Background="#C3073F"/>
        <Button
            x:Name="TetrisButton"
            Click="TetrisButton_Click"
            Grid.Column="0"
            Grid.Row="4"
            Margin="8"
            Content="Стажировка в новострое"
            FontSize="{StaticResource menuButtonFontSize}"
            FontFamily="Comic Sans MS"
            Opacity="{StaticResource menuButtonOpacity}"
            MouseEnter="Button_MouseEnter_InputMeme" 
            BorderBrush="#FF950740"
            Background="#C3073F"/>
        <Button
            x:Name="ExitButton"
            Click="ExitButton_Click"
            Grid.Column="0"
            Grid.Row="5"
            Margin="8"
            Content="[!] Взять в долг [!]"
            FontSize="{StaticResource menuButtonFontSize}"
            FontFamily="Comic Sans MS"
            Opacity="{StaticResource menuButtonOpacity}"
            MouseEnter="Button_MouseEnter_InputMeme" 
            BorderBrush="#FF950740"
            Background="Red"/>
        <Image
            x:Name="memeImage"
            Grid.Column="1"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center" 
            Stretch ="Uniform"
            Grid.RowSpan="7" 
            Source="/Images/cosmenu.jpg"/>
    </Grid>
</Window>
